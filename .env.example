# Copy this file to .env and replace the placeholders with your own values.
# .env is git-ignored; never commit a real .env.
#
# EMBEDDINGS_* are read by fastify-embeddings and by `pnpm smoke:real`.
# QDRANT_* are read by the standalone app in examples/ollama-qdrant.
#
# Values below are placeholders only. Shell variables take priority over .env,
# so CI and production can inject the real values without a .env file at all.
EMBEDDINGS_BASE_URL=http://ollama.example.internal:11434
EMBEDDINGS_FORMAT=ollama
EMBEDDINGS_MODEL=nomic-embed-text
QDRANT_URL=http://qdrant.example.internal:6333
QDRANT_API_KEY=changeme
